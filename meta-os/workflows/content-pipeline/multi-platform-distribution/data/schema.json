{
  "input": {
    "finalized_content": {
      "type": "object",
      "description": "Approved content ready for distribution",
      "properties": {
        "content_id": {"type": "string"},
        "headline": {"type": "string"},
        "body_copy": {"type": "object", "properties": {"facebook": {"type": "string"}, "instagram": {"type": "string"}, "twitter_x": {"type": "string"}, "linkedin": {"type": "string"}, "google_my_business": {"type": "string"}}},
        "hashtags": {"type": "object", "properties": {"instagram": {"type": "array", "items": {"type": "string"}}, "twitter_x": {"type": "array", "items": {"type": "string"}}, "linkedin": {"type": "array", "items": {"type": "string"}}}},
        "cta": {"type": "string"},
        "link_url": {"type": "string"}
      },
      "required": ["content_id", "body_copy"]
    },
    "designed_assets": {
      "type": "array",
      "description": "Designed media assets from EEVL Creative",
      "items": {
        "type": "object",
        "properties": {
          "asset_url": {"type": "string"},
          "asset_type": {"type": "string", "enum": ["image", "video", "carousel", "story", "reel"]},
          "platform": {"type": "string"},
          "dimensions": {"type": "string"},
          "alt_text": {"type": "string"}
        },
        "required": ["asset_url", "asset_type", "platform"]
      }
    },
    "posting_schedule": {
      "type": "object",
      "description": "Scheduled posting times per platform",
      "properties": {
        "facebook": {"type": "string", "format": "date-time"},
        "instagram": {"type": "string", "format": "date-time"},
        "twitter_x": {"type": "array", "items": {"type": "string", "format": "date-time"}},
        "linkedin": {"type": "string", "format": "date-time"},
        "google_my_business": {"type": "string", "format": "date-time"}
      }
    },
    "target_platforms": {
      "type": "array",
      "description": "Platforms to distribute content to",
      "items": {"type": "string", "enum": ["facebook", "instagram", "twitter_x", "linkedin", "google_my_business"]}
    },
    "ab_test_variants": {
      "type": "object",
      "description": "A/B test caption variants for select platforms",
      "properties": {
        "enabled": {"type": "boolean"},
        "platform": {"type": "string"},
        "variant_a": {"type": "string"},
        "variant_b": {"type": "string"},
        "test_duration_hours": {"type": "integer", "default": 24},
        "success_metric": {"type": "string", "enum": ["engagement_rate", "click_through", "reach"]}
      }
    }
  },
  "output": {
    "post_ids": {
      "type": "object",
      "description": "Published post IDs per platform",
      "properties": {
        "facebook": {"type": "string"},
        "instagram": {"type": "string"},
        "twitter_x": {"type": "array", "items": {"type": "string"}},
        "linkedin": {"type": "string"},
        "google_my_business": {"type": "string"}
      }
    },
    "scheduled_times": {
      "type": "object",
      "description": "Confirmed scheduled times per platform",
      "properties": {
        "facebook": {"type": "string", "format": "date-time"},
        "instagram": {"type": "string", "format": "date-time"},
        "twitter_x": {"type": "array", "items": {"type": "string", "format": "date-time"}},
        "linkedin": {"type": "string", "format": "date-time"},
        "google_my_business": {"type": "string", "format": "date-time"}
      }
    },
    "engagement_metrics": {
      "type": "object",
      "description": "Initial engagement metrics post-publish",
      "properties": {
        "likes": {"type": "integer"},
        "comments": {"type": "integer"},
        "shares": {"type": "integer"},
        "reach": {"type": "integer"},
        "impressions": {"type": "integer"},
        "click_through_rate": {"type": "number"},
        "saves": {"type": "integer"}
      }
    },
    "newsletter_send_status": {
      "type": "object",
      "description": "Email newsletter distribution status",
      "properties": {
        "sent": {"type": "boolean"},
        "send_time": {"type": "string", "format": "date-time"},
        "recipient_count": {"type": "integer"},
        "open_rate": {"type": "number"},
        "click_rate": {"type": "number"}
      }
    },
    "ab_test_results": {
      "type": "object",
      "description": "Results from A/B test caption variants",
      "properties": {
        "winning_variant": {"type": "string", "enum": ["a", "b"]},
        "variant_a_metrics": {"type": "object", "properties": {"engagement_rate": {"type": "number"}, "reach": {"type": "integer"}, "clicks": {"type": "integer"}}},
        "variant_b_metrics": {"type": "object", "properties": {"engagement_rate": {"type": "number"}, "reach": {"type": "integer"}, "clicks": {"type": "integer"}}},
        "performance_delta_percent": {"type": "number"},
        "statistical_significance": {"type": "boolean"}
      }
    }
  }
}
