{
  "input": {
    "signed_contract": {
      "type": "object",
      "description": "Details from the signed client contract",
      "properties": {
        "contract_id": {"type": "string"},
        "signed_date": {"type": "string", "format": "date-time"},
        "contract_url": {"type": "string"},
        "deliverables": {"type": "array", "items": {"type": "string"}},
        "timeline_weeks": {"type": "integer"},
        "budget": {"type": "number"}
      },
      "required": ["contract_id", "signed_date"]
    },
    "client_details": {
      "type": "object",
      "description": "Client company and contact information",
      "properties": {
        "company_name": {"type": "string"},
        "primary_contact_name": {"type": "string"},
        "primary_contact_email": {"type": "string"},
        "additional_contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "email": {"type": "string"},
              "role": {"type": "string"}
            }
          }
        },
        "industry": {"type": "string"},
        "timezone": {"type": "string"}
      },
      "required": ["company_name", "primary_contact_name", "primary_contact_email"]
    },
    "project_scope": {
      "type": "object",
      "description": "Scope of the project determining resource allocation",
      "properties": {
        "project_type": {"type": "string"},
        "description": {"type": "string"},
        "required_roles": {"type": "array", "items": {"type": "string"}},
        "complexity": {"type": "string", "enum": ["low", "medium", "high"]},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"}
      },
      "required": ["project_type"]
    },
    "assigned_team": {
      "type": "array",
      "description": "Pre-assigned team members (optional — TaskMaster AI will assign if empty)",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "email": {"type": "string"}
        }
      }
    },
    "meeting_preferences": {
      "type": "object",
      "description": "Client preferences for the kickoff meeting",
      "properties": {
        "preferred_days": {"type": "array", "items": {"type": "string"}},
        "preferred_time_range": {"type": "string"},
        "duration_minutes": {"type": "integer", "default": 60},
        "video_platform": {"type": "string", "enum": ["google_meet", "zoom", "teams"], "default": "google_meet"}
      }
    }
  },
  "output": {
    "clickup_project_id": {
      "type": "string",
      "description": "ID of the created ClickUp project"
    },
    "clickup_project_url": {
      "type": "string",
      "description": "URL to the created ClickUp project"
    },
    "lark_channel_url": {
      "type": "string",
      "description": "URL to the created Lark channel"
    },
    "notion_workspace_url": {
      "type": "string",
      "description": "URL to the created Notion workspace"
    },
    "kickoff_email_confirmation": {
      "type": "object",
      "description": "Confirmation details for the sent kickoff email",
      "properties": {
        "sent": {"type": "boolean"},
        "sent_at": {"type": "string", "format": "date-time"},
        "recipients": {"type": "array", "items": {"type": "string"}},
        "message_id": {"type": "string"}
      }
    },
    "meeting_details": {
      "type": "object",
      "description": "Scheduled kickoff meeting details",
      "properties": {
        "event_id": {"type": "string"},
        "meeting_url": {"type": "string"},
        "scheduled_date": {"type": "string", "format": "date-time"},
        "duration_minutes": {"type": "integer"},
        "attendees": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
