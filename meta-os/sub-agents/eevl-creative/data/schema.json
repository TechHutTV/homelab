{
  "input": {
    "design_brief": {
      "type": "object",
      "description": "Creative brief describing the design requirements",
      "properties": {
        "title": {"type": "string"},
        "description": {"type": "string"},
        "campaign": {"type": "string"},
        "target_audience": {"type": "string"},
        "key_message": {"type": "string"},
        "cta": {"type": "string"},
        "copy_text": {"type": "object", "properties": {"headline": {"type": "string"}, "subheadline": {"type": "string"}, "body": {"type": "string"}}}
      },
      "required": ["title", "description"]
    },
    "asset_type": {
      "type": "string",
      "description": "Type of design asset to generate",
      "enum": ["social_post", "story", "youtube_thumbnail", "presentation", "print", "carousel", "infographic"]
    },
    "dimensions": {
      "type": "object",
      "description": "Target dimensions for the asset",
      "properties": {
        "width": {"type": "integer"},
        "height": {"type": "integer"},
        "unit": {"type": "string", "enum": ["px", "in", "cm"], "default": "px"},
        "platforms": {
          "type": "array",
          "description": "Target platforms — agent will auto-size to each platform's required dimensions",
          "items": {"type": "string", "enum": ["instagram", "facebook", "stories", "twitter_x", "linkedin", "youtube"]}
        }
      }
    },
    "brand_overrides": {
      "type": "object",
      "description": "Optional overrides to default brand guidelines for this specific design",
      "properties": {
        "color_palette": {"type": "array", "items": {"type": "string"}},
        "font_heading": {"type": "string"},
        "font_body": {"type": "string"},
        "logo_variant": {"type": "string"},
        "style_notes": {"type": "string"}
      }
    },
    "reference_assets": {
      "type": "array",
      "description": "Reference images or designs for creative direction",
      "items": {
        "type": "object",
        "properties": {
          "url": {"type": "string"},
          "description": {"type": "string"},
          "type": {"type": "string", "enum": ["inspiration", "must_include", "style_reference"]}
        }
      }
    }
  },
  "output": {
    "design_file_urls": {
      "type": "array",
      "description": "URLs to the generated design files",
      "items": {
        "type": "object",
        "properties": {
          "url": {"type": "string"},
          "platform": {"type": "string"},
          "dimensions": {"type": "string"},
          "format": {"type": "string", "enum": ["png", "jpg", "pdf", "pptx", "mp4"]}
        }
      }
    },
    "canva_design_ids": {
      "type": "array",
      "description": "Canva design IDs for further editing",
      "items": {"type": "string"}
    },
    "google_drive_locations": {
      "type": "array",
      "description": "Google Drive folder and file URLs for stored assets",
      "items": {
        "type": "object",
        "properties": {
          "file_name": {"type": "string"},
          "folder_path": {"type": "string"},
          "drive_url": {"type": "string"}
        }
      }
    },
    "brand_compliance_score": {
      "type": "number",
      "description": "Brand guideline compliance score from 0-100",
      "minimum": 0,
      "maximum": 100
    }
  }
}
