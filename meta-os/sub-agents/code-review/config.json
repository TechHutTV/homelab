{
  "name": "CodeReview AI",
  "description": "Reads GitHub PR, reviews code, posts feedback",
  "trigger": "github_pr_opened",
  "model": "claude-sonnet-4-6",
  "version": "1.0.0",
  "enabled": true,
  "retry": {
    "max_attempts": 2,
    "backoff_seconds": 15
  },
  "timeout_seconds": 180,
  "paths": {
    "prompt": "prompts/prompt.md",
    "tools": "tools/tools.json",
    "schema": "data/schema.json"
  }
}
