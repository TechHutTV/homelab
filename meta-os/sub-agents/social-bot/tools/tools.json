{
  "tools": [
    {
      "name": "facebook",
      "type": "api",
      "description": "Publish and manage Facebook posts",
      "endpoints": {
        "create_post": {
          "method": "POST",
          "path": "/{page_id}/feed",
          "description": "Publish a post to the Facebook page"
        },
        "upload_photo": {
          "method": "POST",
          "path": "/{page_id}/photos",
          "description": "Upload a photo post"
        },
        "upload_video": {
          "method": "POST",
          "path": "/{page_id}/videos",
          "description": "Upload a video post"
        },
        "get_insights": {
          "method": "GET",
          "path": "/{post_id}/insights",
          "description": "Get engagement metrics for a post"
        }
      },
      "auth": {
        "type": "oauth2",
        "credentials_ref": "vault://facebook/social-bot"
      },
      "config": {
        "page_id": "{{FACEBOOK_PAGE_ID}}"
      }
    },
    {
      "name": "instagram",
      "type": "api",
      "description": "Publish and manage Instagram posts",
      "endpoints": {
        "create_container": {
          "method": "POST",
          "path": "/{ig_user_id}/media",
          "description": "Create media container for publishing"
        },
        "publish_media": {
          "method": "POST",
          "path": "/{ig_user_id}/media_publish",
          "description": "Publish a prepared media container"
        },
        "create_carousel": {
          "method": "POST",
          "path": "/{ig_user_id}/media",
          "description": "Create carousel post with multiple images"
        },
        "get_insights": {
          "method": "GET",
          "path": "/{media_id}/insights",
          "description": "Get engagement metrics for a post"
        }
      },
      "auth": {
        "type": "oauth2",
        "credentials_ref": "vault://instagram/social-bot"
      },
      "config": {
        "ig_user_id": "{{INSTAGRAM_USER_ID}}"
      }
    },
    {
      "name": "twitter",
      "type": "api",
      "description": "Publish and manage Twitter/X posts",
      "endpoints": {
        "create_tweet": {
          "method": "POST",
          "path": "/2/tweets",
          "description": "Post a new tweet"
        },
        "upload_media": {
          "method": "POST",
          "path": "/1.1/media/upload.json",
          "description": "Upload media for tweet attachment"
        },
        "get_tweet_metrics": {
          "method": "GET",
          "path": "/2/tweets/{id}",
          "description": "Get tweet engagement metrics"
        },
        "create_thread": {
          "method": "POST",
          "path": "/2/tweets",
          "description": "Create a tweet thread by replying to previous tweet"
        }
      },
      "auth": {
        "type": "oauth2",
        "credentials_ref": "vault://twitter/social-bot"
      }
    },
    {
      "name": "linkedin",
      "type": "api",
      "description": "Publish and manage LinkedIn posts",
      "endpoints": {
        "create_post": {
          "method": "POST",
          "path": "/v2/posts",
          "description": "Create a new LinkedIn post"
        },
        "upload_image": {
          "method": "POST",
          "path": "/v2/images",
          "description": "Upload image for LinkedIn post"
        },
        "get_share_stats": {
          "method": "GET",
          "path": "/v2/organizationalEntityShareStatistics",
          "description": "Get post engagement statistics"
        }
      },
      "auth": {
        "type": "oauth2",
        "credentials_ref": "vault://linkedin/social-bot"
      },
      "config": {
        "organization_id": "{{LINKEDIN_ORG_ID}}"
      }
    },
    {
      "name": "google_my_business",
      "type": "api",
      "description": "Publish posts to Google My Business listing",
      "endpoints": {
        "create_post": {
          "method": "POST",
          "path": "/v1/{name}/localPosts",
          "description": "Create a new GMB post"
        },
        "get_insights": {
          "method": "GET",
          "path": "/v1/{name}/localPosts/{post_id}",
          "description": "Get post performance metrics"
        }
      },
      "auth": {
        "type": "oauth2",
        "credentials_ref": "vault://google/gmb-social-bot"
      },
      "config": {
        "location_name": "{{GMB_LOCATION_NAME}}"
      }
    },
    {
      "name": "email_newsletter",
      "type": "api",
      "description": "Distribute content via email newsletter",
      "endpoints": {
        "create_campaign": {
          "method": "POST",
          "path": "/v3/campaigns",
          "description": "Create a new email campaign"
        },
        "send_campaign": {
          "method": "POST",
          "path": "/v3/campaigns/{campaign_id}/actions/send",
          "description": "Send the campaign to subscribers"
        },
        "get_report": {
          "method": "GET",
          "path": "/v3/reports/{campaign_id}",
          "description": "Get campaign performance report"
        }
      },
      "auth": {
        "type": "api_key",
        "credentials_ref": "vault://mailchimp/social-bot"
      }
    },
    {
      "name": "analytics",
      "type": "api",
      "description": "Aggregate engagement analytics across platforms",
      "endpoints": {
        "log_metrics": {
          "method": "POST",
          "path": "/v1/metrics",
          "description": "Log engagement metrics for reporting"
        },
        "get_benchmarks": {
          "method": "GET",
          "path": "/v1/benchmarks",
          "description": "Get historical performance benchmarks"
        }
      },
      "auth": {
        "type": "api_key",
        "credentials_ref": "vault://analytics/social-bot"
      }
    }
  ]
}
